/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# Firebase를 쓰는 두 도구는 더 엄격한 CSP를 따로 둔다 (! 로 위의 공통 CSP를 빼고 덮어씀)
# 사이트 공통 Google 로그인(/shared/account.js)을 위해 apis.google.com, Firebase 로그인 창(firebaseapp.com), 프로필 사진(lh3.googleusercontent.com)을 허용
/politics/*
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdnjs.cloudflare.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://www.gstatic.com; frame-src 'self' https://nihongodic.firebaseapp.com

/jeildang/*
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://www.gstatic.com; frame-src 'self' https://nihongodic.firebaseapp.com

# 도감 도우미: Cloudflare 분석 스크립트 + Google 로그인·체크 기록 동기화(Firebase, /pokemon/cloud.js)만 허용
/pokemon/*
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self' https://cloudflareinsights.com https://*.googleapis.com https://www.gstatic.com; frame-src 'self' https://nihongodic.firebaseapp.com; form-action 'none'

# 오답 플래시(/yukyung): 사이트 다른 도구와 분리된 개인 페이지. 검색 제외, 외부 연결은 Google Fonts만
/yukyung/*
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'none'
  X-Robots-Tag: noindex, nofollow

# 판례 노트(/judge): 외부 연결은 Google Fonts만
/judge/*
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'none'
